{
  "name": "fractal-world",
  "private": true,
  "type": "module",
  "description": "No build and no dependencies: these only run the tests.",
  "scripts": {
    "test": "node --test 'tests/unit/*.test.js' && node tests/browser/run.mjs",
    "test:unit": "node --test 'tests/unit/*.test.js'",
    "test:browser": "node tests/browser/run.mjs",
    "test:pictures": "node tests/browser/run.mjs --update 'look as they did'"
  }
}
